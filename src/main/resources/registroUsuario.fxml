<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefWidth="720" prefHeight="780" minWidth="440" minHeight="740" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="monedero.controllers.RegistroUsuarioController" style="-fx-background-color: #F1F5F9; -fx-font-family: 'System'; -fx-accent: #0F766E; -fx-focus-color: #0F766E; -fx-faint-focus-color: #0F766E22;">
<children><StackPane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"><padding><Insets top="24" right="24" bottom="24" left="24" /></padding><children>
<VBox alignment="CENTER" spacing="24" maxWidth="390" maxHeight="-Infinity"><children>
<VBox alignment="CENTER" spacing="6"><children><Label text="Monedero Virtual" style="-fx-font-size: 28px; -fx-text-fill: #0F172A; -fx-font-weight: bold;" /><Label text="Tu dinero y tus puntos" style="-fx-font-size: 14px; -fx-text-fill: #64748B;" /></children></VBox>
<VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 20, 0, 0, 6);"><padding><Insets top="28" right="28" bottom="28" left="28" /></padding><children><Label text="Crear cuenta" style="-fx-font-size: 26px; -fx-text-fill: #0F172A; -fx-font-weight: bold;" /><Label text="Comienza a organizar tu dinero." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" /><VBox spacing="7"><children><Label text="Documento de identificación" style="-fx-font-size: 14px; -fx-text-fill: #334155;" /><TextField fx:id="txtIdUsuario" promptText="Ingresa tu documento" prefHeight="42" minHeight="42" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CBD5E1; -fx-padding: 10 12;" /></children></VBox><VBox spacing="7"><children><Label text="Nombre" style="-fx-font-size: 14px; -fx-text-fill: #334155;" /><TextField fx:id="txtNombre" promptText="Ingresa tu nombre" prefHeight="42" minHeight="42" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CBD5E1; -fx-padding: 10 12;" /></children></VBox><VBox spacing="7"><children><Label text="Contraseña" style="-fx-font-size: 14px; -fx-text-fill: #334155;" /><PasswordField fx:id="txtPassword" promptText="Crea tu contraseña" prefHeight="42" minHeight="42" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CBD5E1; -fx-padding: 10 12;" /></children></VBox><VBox spacing="7"><children><Label text="Confirmar contraseña" style="-fx-font-size: 14px; -fx-text-fill: #334155;" /><PasswordField fx:id="txtPassword2" promptText="Repite tu contraseña" prefHeight="42" minHeight="42" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CBD5E1; -fx-padding: 10 12;" /></children></VBox>
<Label fx:id="lblMensaje" wrapText="true" minHeight="34" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #B91C1C;" />
<Button text="Crear usuario" onAction="#CrearUsuario" mnemonicParsing="false" maxWidth="Infinity" minHeight="44" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 11 18;" />
<Button text="Regresar al inicio de sesión" onAction="#regresarALogin" mnemonicParsing="false" maxWidth="Infinity" minHeight="42" style="-fx-background-color: #F0FDFA; -fx-text-fill: #0F766E; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #99F6E4; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 11 16;" />
